# Database connection URL (Default SQLite for instant local zero-config execution; switch to PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# For PostgreSQL production, set:
# DATABASE_URL="postgresql://user:password@localhost:5432/alhadi_erp?schema=public"

# Authentication secret
AUTH_SECRET="your-super-secret-jwt-key"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Configuration (local | s3 | cloudinary)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./public/uploads"

# WhatsApp Configuration (simulator | twilio | meta)
WHATSAPP_PROVIDER="simulator"
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""
